---
import './entry.css';
---
<main class="historyChannel" data-history-channel aria-label="KOREA / AXIS Korean History channel">
  <nav class="historyChannelUtility" aria-label="History channel context">
    <a href="/?scene=academia">FORMA OPUS / ACADEMIA</a>
    <span>KOREAN HISTORY</span>
  </nav>

  <section class="historyEntryStage" data-history-stage data-phase="prelude">
    <div class="historyThemeWash" aria-hidden="true"></div>
    <div class="historyCenterAccent" aria-hidden="true"></div>

    <div class="historyPrelude" aria-hidden="true">
      <strong>HISTORY</strong>
      <small>KOREAN HISTORY / ACADEMIA</small>
    </div>

    <div class="historyParticleField" data-history-particles aria-hidden="true"></div>

    <div class="historyGateScene" data-history-gate-scene>
      <div class="historyGateAura" aria-hidden="true"></div>
      <div class="historyGate" data-history-gate>
        <div class="historyGateFrame" aria-hidden="true">
          <span class="historyGateLintel"></span>
          <span class="historyGatePost postLeft"></span>
          <span class="historyGatePost postRight"></span>
        </div>

        <div class="historyGateLight" aria-hidden="true"></div>

        <div class="historyDoor doorLeft" aria-hidden="true">
          <span class="doorInnerLine"></span>
          <svg class="historyNacre historyNacreLeft" viewBox="0 0 500 760" preserveAspectRatio="none">
            <path d="M90 610 C160 520 155 430 222 365 C272 316 312 260 344 164" />
            <path d="M116 566 C174 552 211 526 244 482" />
            <path d="M188 430 C146 398 128 354 128 302" />
            <path d="M248 344 C300 352 346 334 388 296" />
            <path d="M312 248 C282 210 276 178 292 130" />
          </svg>
        </div>

        <div class="historyDoor doorRight" aria-hidden="true">
          <span class="doorInnerLine"></span>
          <svg class="historyNacre historyNacreRight" viewBox="0 0 500 760" preserveAspectRatio="none">
            <path d="M410 610 C340 520 345 430 278 365 C228 316 188 260 156 164" />
            <path d="M384 566 C326 552 289 526 256 482" />
            <path d="M312 430 C354 398 372 354 372 302" />
            <path d="M252 344 C200 352 154 334 112 296" />
            <path d="M188 248 C218 210 224 178 208 130" />
          </svg>
        </div>

        <div class="historyGateSeam" aria-hidden="true"></div>
        <div class="historyRingPair" aria-hidden="true">
          <span class="historyRing ringLeft"></span>
          <span class="historyRing ringRight"></span>
        </div>

        <button class="historyGateHit" type="button" data-history-open aria-label="Enter KOREA / AXIS"></button>
      </div>
      <p class="historyGateInstruction" aria-hidden="true">OPEN / KOREA · AXIS</p>
    </div>

    <div class="historyExposure" aria-hidden="true"></div>

    <section class="historyReady" aria-label="KOREA / AXIS master history interface">
      <div class="historyConceptGlyph" aria-hidden="true">基軸</div>

      <header class="historyReadyIdentity">
        <span>FORMA OPUS / ACADEMIA</span>
        <h1>KOREA / AXIS</h1>
        <small>KOREAN HISTORY</small>
      </header>

      <div class="historyAxisWrap">
        <canvas class="historyBrushCanvas" data-history-brush aria-hidden="true"></canvas>
        <svg class="historyAxisFallback" viewBox="0 0 112 1000" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <filter id="historyBrushRoughness" x="-35%" y="-5%" width="170%" height="110%">
              <feTurbulence type="fractalNoise" baseFrequency="0.041 0.006" numOctaves="3" seed="29" result="noise"/>
              <feDisplacementMap in="SourceGraphic" in2="noise" scale="5.8" xChannelSelector="R" yChannelSelector="G"/>
            </filter>
          </defs>
          <path class="historyAxisFallbackStroke" d="M57 8 C46 108 66 205 53 312 C44 415 66 505 53 610 C46 712 63 812 50 992" filter="url(#historyBrushRoughness)"/>
        </svg>

        <button class="historyAxisNode" type="button" data-history-axis-node aria-expanded="false" aria-controls="history-axis-summary">
          <span class="historyAxisNodeDot" aria-hidden="true"></span>
          <span class="historyAxisNodeLabel">PROTOTYPE / 01</span>
        </button>
      </div>

      <aside class="historyAxisSummary" id="history-axis-summary" data-history-summary aria-hidden="true">
        <span class="historyAxisSummaryEyebrow">FIRST RESPONSE / SUMMARY</span>
        <h2>ERA</h2>
        <p>Historical structure will open here without replacing the master axis.</p>
        <dl>
          <div><dt>MODE</dt><dd>SUMMARY / STRUCTURE</dd></div>
          <div><dt>STATUS</dt><dd>INTERACTION CONTRACT</dd></div>
        </dl>
        <button type="button" data-history-detail>OPEN DETAIL HOOK <span aria-hidden="true">↗</span></button>
      </aside>

      <div class="historyDetailHook" data-history-detail-hook aria-hidden="true">
        <span>SECOND RESPONSE / DETAIL</span>
        <strong>DETAIL FOUNDATION</strong>
        <p>No historical detail is populated in this patch. This state only validates the transition contract.</p>
        <button type="button" data-history-detail-close>CLOSE</button>
      </div>
    </section>

    <div class="historyLiveRegion srOnly" aria-live="polite" data-history-live></div>
  </section>
</main>

<script>
  import { mountHistoryChannelEntry } from './entry-controller';
  const channel = document.querySelector<HTMLElement>('[data-history-channel]');
  if (channel) mountHistoryChannelEntry(channel);
</script>
