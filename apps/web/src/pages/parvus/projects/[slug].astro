---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CleanWip from '../../../components/CleanWip.astro';
import '@forma-opus/parvus/domain.css';
import { ParvusProjectDetail } from '@forma-opus/parvus'; import { parvusProjects } from '@content/parvus/index';
