---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CleanWip from '../../../components/CleanWip.astro';
import '@forma-opus/grea/domain.css';
import { FaberStudy, GreaNav } from '@forma-opus/grea';
import { greaProducts, getGreaProduct } from '@content/grea/index';
export function getStaticPaths(){ return greaProducts.filter((p)=>p.lineId==='faber').map((p)=>({params:{slug:p.slug}})); }
const p=getGreaProduct(Astro.params.slug!); if(!p) return Astro.redirect('/404');
---
<BaseLayout title="FABER — FORMA OPUS" bodyClass="fo-clean-body"><CleanWip project="FABER" backHref="/grea" backLabel="GREA" /></BaseLayout>
