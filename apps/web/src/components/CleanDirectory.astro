---
interface Entry { title: string; description: string; slug: string }
interface Props { section: string; parentText: string; parentHref: string; entries: readonly Entry[]; title?: string }
const { section, parentText, parentHref, entries, title = section } = Astro.props;
---
<main class="fo-clean">
  <header class="fo-top"><a href={parentHref}>← {parentText}</a><span>FORMA OPUS / {section}</span></header>
  <div class="fo-main"><small>PROJECT DIRECTORY / {section}</small><h1>{title}</h1><div class="fo-rows">
    {entries.map((item, i) => <a href={`/project/${item.slug}`} class="fo-row"><em>{String(i+1).padStart(2,'0')}</em><strong>{item.title}</strong><span>{item.description}</span><b aria-hidden="true">↗</b></a>)}
  </div></div>
</main>
<style is:global>
body.fo-clean-body{background:#fff!important;color:#000!important;color-scheme:light;}
</style>
<style>
.fo-clean{font-family:Arial,Helvetica,sans-serif;background:#fff;color:#000;min-height:100svh;min-height:100dvh;}
.fo-top{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:28px clamp(24px,5vw,84px);border-bottom:1px solid #e6e6e6;font-size:11px;letter-spacing:.13em;font-weight:700;}
.fo-top a{text-decoration:none;color:inherit}.fo-top span{color:#888;font-size:10px}
.fo-main{margin:auto;max-width:1300px;padding:clamp(70px,14vh,160px) clamp(24px,5vw,84px) 120px;}
.fo-main small{color:#888;letter-spacing:.22em;font-size:10px}.fo-main h1{font-size:clamp(66px,12vw,160px);letter-spacing:-.1em;line-height:1;margin:15px 0 80px;font-weight:850;}
.fo-rows{border-top:2px solid #111}.fo-row{display:grid;grid-template-columns:45px minmax(0,1fr) minmax(0,1.15fr) 24px;gap:20px;align-items:center;min-height:98px;padding:15px 4px;border-bottom:1px solid #ddd;text-decoration:none;color:inherit;}
.fo-row em{font-size:10px;font-style:normal;color:#999}.fo-row strong{font-size:clamp(18px,2.8vw,32px);letter-spacing:-.055em}.fo-row span{font-size:13px;line-height:1.5;color:#777}.fo-row b{text-align:right;font-size:18px}.fo-row:hover strong{text-decoration:underline;text-underline-offset:5px}
@media(max-width:670px){.fo-row{grid-template-columns:30px 1fr 22px;gap:8px;min-height:90px}.fo-row span{grid-column:2;grid-row:2;margin-top:-12px}.fo-row b{grid-column:3;grid-row:1/3}.fo-main h1{margin-bottom:55px}}
</style>
